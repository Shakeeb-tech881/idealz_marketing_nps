# ---------------------------------------------------------------------------
# iDealz Lanka CX & NPS Platform — environment variables
# Copy to .env.local for development. In production set these in Vercel.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS — used for the public survey flow, webhooks, cron and user invitations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build survey links sent by SMS (no trailing slash)
NEXT_PUBLIC_APP_URL=https://feedback.idealzlanka.com

# SMS provider: "mock" (default — logs messages as TEST, never sends) or "dialog_esms"
SMS_PROVIDER=mock

# Dialog eSMS (https://e-sms.dialog.lk) — the username/password you log in to eSMS with.
# Server-only: set these in Vercel, never in code or GitHub.
DIALOG_ESMS_USERNAME=
DIALOG_ESMS_PASSWORD=
# Your approved SMS mask (sender ID), max 11 characters, e.g. iDealzLanka
DIALOG_ESMS_SOURCE_ADDRESS=
# 0 = pay from eSMS wallet (default), 4 = pay from an eSMS API package
DIALOG_ESMS_PAYMENT_METHOD=0
# Optional overrides — leave unset to use the endpoints from eSMS API document v3.2
# DIALOG_ESMS_LOGIN_URL=https://esms.dialog.lk/api/v2/user/login
# DIALOG_ESMS_API_BASE_URL=https://e-sms.dialog.lk/api/v2

# Delivery reports: when set, each SMS asks eSMS to report Delivered / Failed to
# /api/webhooks/sms?secret=... Generate: openssl rand -hex 24
SMS_WEBHOOK_SECRET=

# Secret for the daily maintenance cron (/api/cron/maintenance). Vercel Cron sends it
# automatically as "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=
