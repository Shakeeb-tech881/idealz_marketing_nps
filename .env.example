# ---------------------------------------------------------------------------
# iDealz Lanka CX & NPS Platform — environment variables
# Copy to .env.local for development. In production set these in Vercel.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS — used for the public survey flow, webhooks, cron and user invitations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build survey links sent by SMS (no trailing slash)
NEXT_PUBLIC_APP_URL=https://feedback.idealzlanka.com

# SMS provider: "mock" (default — logs messages as TEST, never sends) or "reachout"
SMS_PROVIDER=mock

# Reachout.lk — fill in from your Reachout.lk account / official API documentation.
# Only the variables the official API actually requires need to be set.
REACHOUT_API_BASE_URL=
REACHOUT_API_KEY=
REACHOUT_API_SECRET=
REACHOUT_SENDER_ID=

# Shared secret for the delivery-report webhook (/api/webhooks/sms?secret=...).
# Only needed if Reachout.lk supports delivery reports.
SMS_WEBHOOK_SECRET=

# Secret for the daily maintenance cron (/api/cron/maintenance). Vercel Cron sends it
# automatically as "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=
